# Base URL of the Laravel REST API (no trailing slash, includes /api).
# A relative path is proxied to http://127.0.0.1:8000 by the Vite dev/preview
# server, so the app also works when exposed through a tunnel or another host.
VITE_API_BASE_URL=/api

# Name shown in the interface
VITE_APP_NAME=TrikeTrack
